// ============================================================
// Real-Time Dashboard "Power Mix Germany"
// Page 2: "Electricity Prices" – day-ahead electricity prices
// Data source: Eventhouse eh_1, data from EnergyPriceIngest
// (endpoint == "price", bidding zone DE-LU, 15-min grid)
//
// Conversion: EUR/MWh / 10 = ct/kWh
// Tomorrow's prices are published daily at around 13:00 local time.
// Attribution required by the licence:
//   "Electricity prices: Bundesnetzagentur | SMARD.de (CC BY 4.0)"
//
// Layout:
//   Row 1: Price Now | Price Overview Today/Tomorrow
//   Row 2: Price Today and Tomorrow (full width)
//   Row 3: Price vs. Renewable Share (full width)
//   Row 4: Data Sources (Markdown, full width)
// ============================================================


// ------------------------------------------------------------
// Check after the first run
// ------------------------------------------------------------
energy_latest
| where endpoint == "price"
| summarize Values = count(), From = min(ts), To = max(ts) by series_id, series_name, unit


// ------------------------------------------------------------
// Tile P1: Price Now                         Visual: Stat (ct/kWh)
// Description: Day-ahead exchange price of the current quarter-hour in
//   cents per kWh (bidding zone Germany/Luxembourg). This is the
//   wholesale price – household tariffs additionally include grid
//   fees, taxes and levies.
// ------------------------------------------------------------
energy_latest
| where endpoint == "price" and ts <= now()
| top 1 by ts desc
| project ["Price now (ct/kWh)"] = round(value / 10, 2),
          ["As of"] = datetime_utc_to_local(ts, "Europe/Berlin")


// ------------------------------------------------------------
// Tile P2: Price Today and Tomorrow          Visual: Column chart
//   X: Time, Y: ct/kWh, Series: Day
//   Y axis label "ct/kWh"; optional reference line at 0
// Description: Day-ahead exchange price per quarter-hour in ct/kWh for
//   today and – once published (usually from about 13:00) – for
//   tomorrow. Bars below zero mean negative prices: more power is
//   available than needed, often at midday with lots of sun.
// ------------------------------------------------------------
let today = startofday(datetime_utc_to_local(now(), "Europe/Berlin"));
energy_latest
| where endpoint == "price"
| extend Time = datetime_utc_to_local(ts, "Europe/Berlin")
| where Time >= today and Time < today + 2d
| project Time,
          Day = iff(Time < today + 1d, "Today", "Tomorrow"),
          ["ct/kWh"] = round(value / 10, 2)
| order by Time asc


// ------------------------------------------------------------
// Tile P3: Price Overview Today/Tomorrow (ct/kWh)   Visual: Table
// Description: Avg = daily average, Min/Max = cheapest/most expensive
//   quarter-hour, Cheapest at = time of the lowest price, Negative ¼h =
//   number of quarter-hours with a negative price.
// arg_min is computed separately and joined, because it cannot be
// combined with the other aggregates in one summarize.
// ------------------------------------------------------------
let today = startofday(datetime_utc_to_local(now(), "Europe/Berlin"));
let base = energy_latest
    | where endpoint == "price"
    | extend Time = datetime_utc_to_local(ts, "Europe/Berlin")
    | where Time >= today and Time < today + 2d
    | extend Day = iff(Time < today + 1d, "Today", "Tomorrow");
base
| summarize AvgPrice = avg(value), MaxPrice = max(value), Negative = countif(value < 0) by Day
| join kind=inner (base | summarize arg_min(value, Time) by Day) on Day
| project Day,
          ["Avg"] = round(AvgPrice / 10, 2),
          ["Min"] = round(value / 10, 2),
          ["Cheapest at"] = format_datetime(Time, "HH:mm"),
          ["Max"] = round(MaxPrice / 10, 2),
          ["Negative ¼h"] = Negative
| order by Day asc


// ------------------------------------------------------------
// Tile P4: Price vs. Renewable Share         Visual: Line chart, 2 Y axes
//   X: Time
//   Main Y axis:   Price_ct_kWh          (colour orange, label "Price (ct/kWh)")
//   Second Y axis: Renewable_Share_Pct   (colour blue,   label "Renewable share (%)")
//   Reference lines: 0 and 100
// Description: Exchange price (left axis) compared with the renewable
//   share of the load (right axis). Shows the relationship: lots of
//   green power = low price, little green power = high price.
// Wide format (one column per series) is required for the second axis.
// ------------------------------------------------------------
let price = energy_latest
    | where endpoint == "price" and ts between (_startTime .. _endTime)
    | project ts, Price_ct_kWh = round(value / 10, 2);
let renewables = energy_latest
    | where endpoint == "public_power" and series_id == "renewable_share_of_load"
        and ts between (_startTime .. _endTime)
    | project ts, Renewable_Share_Pct = round(value, 1);
price
| join kind=fullouter renewables on ts
| project Time = datetime_utc_to_local(coalesce(ts, ts1), "Europe/Berlin"),
          Price_ct_kWh, Renewable_Share_Pct
| order by Time asc


