// ============================================================
// Activator alerts – queries for the KQL queryset "Power Mix Alerts"
// Database eh_1, Activator item: "Power Mix Activator" (holds all rules)
//
// How to create an alert:
//   1. Paste a query into the queryset and run it.
//   2. Click "Add alert" in the toolbar.
//   3. Check: "On each event when" – this option only appears if the
//      query ends with "| render card".
//   4. Condition: "Numeric change" -> "Increases above" / "Decreases below".
//      These conditions fire only when the value CROSSES the threshold,
//      not on every query run.
//   5. Occurrence: "Every time the condition is met".
//   6. Action: Email. Context / additional information: add all columns
//      of the query first. Then insert column values into the text by
//      typing "@" and PICKING the column from the list (it becomes a
//      highlighted chip). Pasted or typed "@ColumnName" stays plain text
//      and is NOT replaced in the e-mail. In the notes below, every
//      @ColumnName marks such a chip.
//      Do not insert datetime columns (AsOf, LastIngestion) into the text:
//      they appear as ISO with a misleading "Z" (e.g. 2026-10-13T10:15:00Z),
//      although the value is German local time. Keep them in Context only –
//      the table below the message shows them readable.
//   7. Save to the existing item "Power Mix Activator".
//
// Note: a rule can fire immediately after creation if the current
// value already meets the condition.
// Do not rename output columns – the rules refer to them.
// ============================================================


// ------------------------------------------------------------
// Alert 1 + 2: Traffic light (green = 2, grid congestion = -1)
//   One query, two rules. Run query every: 15 minutes
//
//   Alert 1 – rule name: "Lots of Green Power"
//     When: TrafficLight -> Increases above 1
//     Subject:  "🟢 Lots of green power right now"
//     Headline: "Traffic light switched to green"
//     Notes:    "Renewables are covering @RenewableShare % of Germany's power demand
//                right now. Good time to run the dishwasher or washing machine, or to
//                charge the EV. The forecast for the next hours is on the Grid Live
//                page of the Power Mix Germany dashboard. AsOf below is German local
//                time."
//
//   Alert 2 – rule name: "Grid Congestion"
//     When: TrafficLight -> Decreases below 0
//     Subject:  "⛔ Grid congestion in the German power grid"
//     Headline: "Traffic light switched to grid congestion"
//     Notes:    "The Energy-Charts traffic light reports grid congestion.
//                Power lines in parts of the grid are at their limit – this is not a
//                power shortage. Renewable share right now: @RenewableShare %.
//                If you can, move heavy loads such as EV charging or a heat pump to
//                a later time. AsOf below is German local time."
// ------------------------------------------------------------
let ts_now = toscalar(
    energy_latest
    | where endpoint == "signal" and ts <= now()
    | summarize max(ts));
energy_latest
| where endpoint == "signal" and ts == ts_now
| summarize TrafficLight = toint(maxif(value, series_id == "signal")),
            RenewableShare = round(maxif(value, series_id == "share"), 1)
    by ts
| project TrafficLight, RenewableShare, AsOf = datetime_utc_to_local(ts, "Europe/Berlin")
| render card


// ------------------------------------------------------------
// Alert 3 – rule name: "High Export"
//   When: NetImport_GW -> Decreases below -5   (export above 5 GW)
//   Run query every: 15 minutes
//   Subject:  "⚡ Germany is exporting more than 5 GW of power"
//   Headline: "High net power export"
//   Notes:    "Net exchange with all neighbors: @NetImport_GW GW (negative = export)
//              in the latest complete quarter-hour. That is more than the output of
//              five large power plant units. High exports usually mean plenty of wind
//              or solar power in Germany. Which countries take the power: see
//              Cross-Border Flows on the Grid Live page. AsOf below is German
//              local time."
//   Only uses the latest completely reported timestamp
//   (same completeness rule as the dashboard tiles):
//   all 11 countries; if none within the last 6 h, at least 10 of 11.
// ------------------------------------------------------------
let cbpf_ts = energy_latest
    | where endpoint == "cbpf" and series_id != "sum"
    | summarize Reported = countif(value != 0) by ts;
let cbpf_max = toscalar(energy_latest | where endpoint == "cbpf" | summarize max(ts));
let complete11 = toscalar(cbpf_ts | where ts <= cbpf_max - 30m and Reported >= 11 | summarize max(ts));
let complete10 = toscalar(cbpf_ts | where ts <= cbpf_max - 30m and Reported >= 10 | summarize max(ts));
let LatestComplete = iff(isnotnull(complete11) and complete11 >= cbpf_max - 6h, complete11, complete10);
energy_latest
| where endpoint == "cbpf" and series_id == "sum" and ts == LatestComplete
| project NetImport_GW = round(value, 2),
          AsOf = datetime_utc_to_local(ts, "Europe/Berlin")
| render card


// ------------------------------------------------------------
// Alert 4 – rule name: "Data Outage"
//   When: MinutesWithoutData -> Increases above 30
//   Run query every: 5 minutes
//   Normal: 0–5 minutes (EnergyIngest runs every 5 minutes)
//   Subject:  "🔧 Power mix pipeline: no new data"
//   Headline: "Pipeline outage"
//   Notes:    "No new data for @MinutesWithoutData minutes.
//              Normally new data arrives every 5 minutes. Check in this order:
//              1. Function App – are EnergyIngest runs failing?
//              2. Eventstream PowerMix Stream – does the source receive events?
//              3. Energy-Charts API – is api.energy-charts.info reachable?
//              Until this is fixed, dashboard and alerts show outdated values.
//              LastIngestion below is German local time."
// ------------------------------------------------------------
energy_raw
| where ingestion_time() > ago(1d)
| summarize LastIngestionUtc = max(ingestion_time())
| project MinutesWithoutData = datetime_diff("minute", now(), LastIngestionUtc),
          LastIngestion = datetime_utc_to_local(LastIngestionUtc, "Europe/Berlin")
| render card


// ------------------------------------------------------------
// Alert 5 – rule name: "Negative Prices Tomorrow"
//   When: NegativeQuarterHoursTomorrow -> Increases above 0
//   Run query every: 15 minutes
//   Fires once a day as soon as the auction for tomorrow is
//   published (around 13:00) and contains negative prices.
//   Subject:  "💶 Negative electricity prices tomorrow"
//   Headline: "Tomorrow's auction contains negative prices"
//   Notes:    "Tomorrow's day-ahead auction has @NegativeQuarterHoursTomorrow
//              quarter-hours with a negative price. Lowest price: @MinPrice_ct_kWh
//              ct/kWh. With a dynamic tariff, plan EV charging and heavy appliances
//              for these hours – exact times are on the Electricity Prices page.
//              Grid fees and taxes still apply, so the price you pay usually stays
//              positive."
// ------------------------------------------------------------
let tomorrow = startofday(datetime_utc_to_local(now(), "Europe/Berlin")) + 1d;
energy_latest
| where endpoint == "price"
| extend Time = datetime_utc_to_local(ts, "Europe/Berlin")
| where Time >= tomorrow and Time < tomorrow + 1d
| summarize NegativeQuarterHoursTomorrow = countif(value < 0),
            MinPrice_ct_kWh = round(min(value) / 10, 2)
| render card


// ------------------------------------------------------------
// Alert 6 – rule name: "Price Negative Now"
//   When: Price_ct_kWh -> Decreases below 0
//   Run query every: 15 minutes
//   Subject:  "💶 Electricity price is negative right now"
//   Headline: "Negative exchange price"
//   Notes:    "Day-ahead price for the current quarter-hour: @Price_ct_kWh ct/kWh.
//              There is more power in the grid than needed, usually
//              from strong solar or wind. With a dynamic tariff, now is the time for
//              heavy loads. Prices for the next hours: Electricity Prices page.
//              AsOf below is German local time."
// ------------------------------------------------------------
energy_latest
| where endpoint == "price" and ts <= now()
| top 1 by ts desc
| project Price_ct_kWh = round(value / 10, 2),
          AsOf = datetime_utc_to_local(ts, "Europe/Berlin")
| render card


// ------------------------------------------------------------
// Alert 7 – rule name: "Frequency Deviation"
//   When: MaxDeviation_mHz -> Increases above 100
//   Run query every: 5 minutes
//   Largest deviation from 50 Hz within the last 6 minutes of data
//   (6 instead of 5 so consecutive runs overlap and no spike is missed).
//   Note: do not name a variable "latest" – it is a reserved word in KQL.
//   100 mHz is rare (weeks can pass without); use 50 for more alerts.
//   Subject:  "〰️ Grid frequency deviates strongly"
//   Headline: "Grid frequency more than 100 mHz away from 50 Hz"
//   Notes:    "The grid frequency deviated strongly from 50 Hz. Maximum deviation
//              in mHz: @MaxDeviation_mHz. Range in Hz: @Lowest_Hz – @Highest_Hz.
//              Below 50 Hz the grid is short of power, above 50 Hz it has too much;
//              reserve power steps in automatically within seconds. Deviations above
//              100 mHz are rare and often happen at the full hour, when power plant
//              schedules change. Details: Grid Frequency page. AsOf below is German
//              local time."
//   (Units are placed BEFORE the chips: a word typed right after a chip
//   was lost in the Activator editor.)
// ------------------------------------------------------------
let last_ts = toscalar(GridFrequency() | summarize max(ts));
GridFrequency()
| where ts > last_ts - 6m
| summarize MaxDeviation_mHz = max(abs(deviation_mhz)),
            Lowest_Hz = round(min(hz), 3),
            Highest_Hz = round(max(hz), 3)
| extend AsOf = datetime_utc_to_local(last_ts, "Europe/Berlin")
| render card
