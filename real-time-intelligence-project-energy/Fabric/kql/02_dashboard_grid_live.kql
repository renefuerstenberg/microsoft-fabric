// ============================================================
// Real-Time Dashboard "Power Mix Germany"
// Page 1: "Grid Live" – tile queries
// Data source: Eventhouse eh_1
//
// Time-series tiles use the dashboard parameter "Time range"
// (_startTime / _endTime). Recommendation: default "Last 24 hours",
// auto refresh 5 minutes. The parameter must be shown on all pages
// (parameter settings -> Show on pages -> Select all).
// All times are converted to local time (Europe/Berlin) for display.
//
// Each tile below lists: tile name, visual settings and the text
// for the tile description.
//
// Layout:
//   Row 1: Traffic Light Now | Renewable Share Now | Net Import Now | Data Status
//   Row 2: Power Mix (full width, large)
//   Row 3: Load and Residual Load | Renewable Share – Actual and Forecast
//   Row 4: Cross-Border Flows by Country | Net Import over Time
//   Row 5: Data Sources (Markdown, full width)
// ============================================================


// ------------------------------------------------------------
// Tile 1: Traffic Light Now                  Visual: Stat (or Table)
// Description: Current Energy-Charts traffic light for this
//   quarter-hour. Green = high share of renewables (good time to use
//   electricity), yellow = average, red = low share of renewables,
//   grid congestion = regional grid bottlenecks.
// ------------------------------------------------------------
energy_latest
| where endpoint == "signal" and series_id == "signal" and ts <= now()
| top 1 by ts desc
| project ["Traffic light"] = case(
        value == 2,  "🟢 Green – lots of renewables",
        value == 1,  "🟡 Yellow – average",
        value == 0,  "🔴 Red – little renewables",
        value == -1, "⛔ Red – grid congestion",
                     "unknown"),
          ["As of"] = datetime_utc_to_local(ts, "Europe/Berlin")


// ------------------------------------------------------------
// Tile 2: Renewable Share Now                Visual: Stat (unit %)
// Description: Share of renewable generation in the current
//   electricity consumption (load). Values above 100 % mean more green
//   power is generated than consumed – the surplus is exported or stored.
// ------------------------------------------------------------
energy_latest
| where endpoint == "signal" and series_id == "share" and ts <= now()
| top 1 by ts desc
| project ["Renewable share %"] = round(value, 1)


// ------------------------------------------------------------
// Tile 3: Net Import Now                     Visual: Stat (GW)
// Description: Physical net power exchange with all neighboring
//   countries for the latest completely reported quarter-hour.
//   Positive = Germany imports, negative = Germany exports.
// ------------------------------------------------------------
// The most recent cbpf quarter-hours are incomplete at first (missing
// countries = 0). Individual countries (especially Sweden) report late.
// Therefore: use the latest timestamp at least 30 min before the newest
// one with all 11 countries reported; if there is none within the last
// 6 h (e.g. cable maintenance = genuine 0), at least 10 of 11.
let cbpf_ts = energy_latest
    | where endpoint == "cbpf" and series_id != "sum"
    | summarize Reported = countif(value != 0) by ts;
let cbpf_max = toscalar(energy_latest | where endpoint == "cbpf" | summarize max(ts));
let complete11 = toscalar(cbpf_ts | where ts <= cbpf_max - 30m and Reported >= 11 | summarize max(ts));
let complete10 = toscalar(cbpf_ts | where ts <= cbpf_max - 30m and Reported >= 10 | summarize max(ts));
let LatestComplete = iff(isnotnull(complete11) and complete11 >= cbpf_max - 6h, complete11, complete10);
energy_latest
| where endpoint == "cbpf" and series_id == "sum" and ts == LatestComplete
| project ["Net import GW"] = round(value, 2),
          ["As of"] = datetime_utc_to_local(ts, "Europe/Berlin")


// ------------------------------------------------------------
// Tile 4: Power Mix                          Visual: Area chart, stacked
//   X: Time, Y: GW, Series: Source
// Description: Public net electricity generation in Germany by
//   energy source in gigawatts (15-minute values). Values are
//   corrected by the source for several hours after publication.
// ------------------------------------------------------------
let Sources = datatable(series_id: string, Source: string)
[
    "fossil_brown_coal_lignite", "Lignite",
    "fossil_hard_coal",          "Hard coal",
    "fossil_gas",                "Natural gas",
    "fossil_oil",                "Other fossil",
    "fossil_coal_derived_gas",   "Other fossil",
    "waste",                     "Other",
    "others",                    "Other",
    "geothermal",                "Other",
    "biomass",                   "Biomass",
    "hydro_run_of_river",        "Hydro",
    "hydro_water_reservoir",     "Hydro",
    "hydro_pumped_storage",      "Pumped storage",
    "wind_offshore",             "Wind offshore",
    "wind_onshore",              "Wind onshore",
    "solar",                     "Solar"
];
energy_latest
| where endpoint == "public_power" and ts between (_startTime .. _endTime)
| join kind=inner Sources on series_id
| summarize GW = round(sum(value) / 1000, 2)
    by Time = datetime_utc_to_local(ts, "Europe/Berlin"), Source
| order by Time asc


// ------------------------------------------------------------
// Tile 5: Load and Residual Load             Visual: Line chart
//   X: Time, Y: GW, Series: Series
// Description: Load = total electricity consumption. Residual load =
//   load minus wind and solar, i.e. what conventional power plants,
//   storage and imports have to cover.
// ------------------------------------------------------------
energy_latest
| where endpoint == "public_power"
    and series_id in ("load", "residual_load")
    and ts between (_startTime .. _endTime)
| project Time = datetime_utc_to_local(ts, "Europe/Berlin"),
          Series = iff(series_id == "load", "Load", "Residual load"),
          GW = round(value / 1000, 2)
| order by Time asc


// ------------------------------------------------------------
// Tile 6: Renewable Share – Actual and Forecast   Visual: Line chart
//   X: Time, Y: Percent, Series: Series
// Description: Renewable share of the load. "Actual" is based on the
//   published generation data, "Signal incl. forecast" continues up to
//   24 hours into the future.
// ------------------------------------------------------------
union
    (energy_latest
     | where endpoint == "public_power" and series_id == "renewable_share_of_load"
     | extend Series = "Actual (generation data)"),
    (energy_latest
     | where endpoint == "signal" and series_id == "share"
     | extend Series = "Signal incl. forecast")
| where ts between (_startTime .. now() + 24h)
| project Time = datetime_utc_to_local(ts, "Europe/Berlin"), Series, Percent = round(value, 1)
| order by Time asc


// ------------------------------------------------------------
// Tile 7: Cross-Border Flows by Country (MW)   Visual: Bar chart
//   X: Country, Y: MW (MW instead of GW so that small flows stay visible)
// Description: Physical power flows with each neighboring country for
//   the latest completely reported quarter-hour. Positive = import into
//   Germany, negative = export.
// Uses the same completeness rule as tile 3.
// ------------------------------------------------------------
let Countries = datatable(series_id: string, Country: string)
[
    "austria", "Austria", "belgium", "Belgium", "czech_republic", "Czech Republic",
    "denmark", "Denmark", "france", "France", "luxembourg", "Luxembourg",
    "netherlands", "Netherlands", "norway", "Norway", "poland", "Poland",
    "sweden", "Sweden", "switzerland", "Switzerland"
];
let cbpf_ts = energy_latest
    | where endpoint == "cbpf" and series_id != "sum"
    | summarize Reported = countif(value != 0) by ts;
let cbpf_max = toscalar(energy_latest | where endpoint == "cbpf" | summarize max(ts));
let complete11 = toscalar(cbpf_ts | where ts <= cbpf_max - 30m and Reported >= 11 | summarize max(ts));
let complete10 = toscalar(cbpf_ts | where ts <= cbpf_max - 30m and Reported >= 10 | summarize max(ts));
let LatestComplete = iff(isnotnull(complete11) and complete11 >= cbpf_max - 6h, complete11, complete10);
energy_latest
| where endpoint == "cbpf" and ts == LatestComplete
| join kind=inner Countries on series_id
| project Country, MW = round(value * 1000, 0)
| order by MW desc


// ------------------------------------------------------------
// Tile 8: Net Import over Time               Visual: Line or column chart
//   X: Time, Y: Net import GW
// Description: Net power exchange with all neighboring countries over
//   time. Positive = import, negative = export. The most recent
//   quarter-hours are only shown once all countries have reported.
// Uses the same completeness rule as tile 3.
// ------------------------------------------------------------
let cbpf_ts = energy_latest
    | where endpoint == "cbpf" and series_id != "sum"
    | summarize Reported = countif(value != 0) by ts;
let cbpf_max = toscalar(energy_latest | where endpoint == "cbpf" | summarize max(ts));
let complete11 = toscalar(cbpf_ts | where ts <= cbpf_max - 30m and Reported >= 11 | summarize max(ts));
let complete10 = toscalar(cbpf_ts | where ts <= cbpf_max - 30m and Reported >= 10 | summarize max(ts));
let LatestComplete = iff(isnotnull(complete11) and complete11 >= cbpf_max - 6h, complete11, complete10);
energy_latest
| where endpoint == "cbpf" and series_id == "sum"
    and ts between (_startTime .. _endTime) and ts <= LatestComplete
| project Time = datetime_utc_to_local(ts, "Europe/Berlin"), ["Net import GW"] = round(value, 2)
| order by Time asc


// ------------------------------------------------------------
// Tile 9: Data Status                        Visual: Table
// Description: Shows how current the data is for each source.
//   Energy-Charts publishes generation data with a delay of usually
//   30–90 minutes; signal and price contain future values.
// ------------------------------------------------------------
energy_latest
| where ts <= now()
| summarize LatestValue = max(ts), LatestRequest = max(generated_at) by endpoint
| project Source = endpoint,
          ["Data until"] = datetime_utc_to_local(LatestValue, "Europe/Berlin"),
          ["Delay (min)"] = datetime_diff("minute", now(), LatestValue),
          ["API as of"] = datetime_utc_to_local(LatestRequest, "Europe/Berlin")


// ------------------------------------------------------------
// Tile 10: Data Sources                      Visual: Markdown tile
