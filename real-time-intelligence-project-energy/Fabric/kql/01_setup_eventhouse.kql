// ============================================================
// Energy-Charts -> Fabric Eventhouse (database: eh_1)
// Setup of the main table energy_raw and the deduplicated view
// energy_latest. Run each block separately in a KQL queryset.
//
// Data flow:
//   Azure Functions -> Eventstream (custom endpoint)
//     -> filter endpoint != "frequency" -> energy_raw     (this file)
//     -> filter endpoint == "frequency" -> frequency_raw  (04_grid_frequency.kql)
//
// Retention: data is kept permanently (36500 days = 100 years).
// ============================================================


// ------------------------------------------------------------
// 1) Raw data table (append-only, one row per value)
// ------------------------------------------------------------
.create-merge table energy_raw (
    endpoint: string,       // public_power | signal | cbpf | price
    country: string,        // e.g. "de"
    ts: datetime,           // start of the interval (UTC)
    series_id: string,      // e.g. "wind_onshore", "solar", "france"
    series_name: string,    // display name according to the API
    value: real,
    unit: string,           // MW, GW, %, EUR/MWh ...
    is_forecast: bool,      // true = interval was in the future at request time
    generated_at: datetime  // creation time of the API response (UTC)
)

// ------------------------------------------------------------
// 2) JSON mapping
//    Only needed for direct ingestion. With "Event processing before
//    ingestion" in the Eventstream, the Eventstream maps the fields itself.
// ------------------------------------------------------------
.create-or-alter table energy_raw ingestion json mapping 'energy_raw_json'
'[{"column":"endpoint","Properties":{"Path":"$.endpoint"}},{"column":"country","Properties":{"Path":"$.country"}},{"column":"ts","Properties":{"Path":"$.ts"}},{"column":"series_id","Properties":{"Path":"$.series_id"}},{"column":"series_name","Properties":{"Path":"$.series_name"}},{"column":"value","Properties":{"Path":"$.value"}},{"column":"unit","Properties":{"Path":"$.unit"}},{"column":"is_forecast","Properties":{"Path":"$.is_forecast"}},{"column":"generated_at","Properties":{"Path":"$.generated_at"}}]'

// ------------------------------------------------------------
// 3) Retention: permanent (100 years = practically unlimited)
//    Hot cache: last 30 days of raw data
// ------------------------------------------------------------
.alter-merge table energy_raw policy retention softdelete = 36500d recoverability = enabled

.alter table energy_raw policy caching hot = 30d

// ------------------------------------------------------------
// 4) Deduplicated view: the most recently delivered value per
//    endpoint/country/series/timestamp. Later corrections of the
//    API therefore automatically replace preliminary values.
//    All dashboard tiles and alerts read from this view.
// ------------------------------------------------------------
.create materialized-view with (backfill=true) energy_latest on table energy_raw
{
    energy_raw
    | summarize arg_max(generated_at, value, unit, series_name, is_forecast)
        by endpoint, country, series_id, ts
}

// ------------------------------------------------------------
// 5) Retention of the materialized view: also permanent
//    Hot cache: 1 year (fast queries for the dashboard)
// ------------------------------------------------------------
.alter-merge materialized-view energy_latest policy retention softdelete = 36500d recoverability = enabled

.alter materialized-view energy_latest policy caching hot = 365d

// ------------------------------------------------------------
// 6) Check: both should show SoftDeletePeriod 36500.00:00:00
// ------------------------------------------------------------
.show table energy_raw policy retention

.show materialized-view energy_latest policy retention


// ============================================================
// CHECKS
// ============================================================

// Which series arrive at all?
energy_latest
| summarize Values = count(), Latest = max(ts) by endpoint, series_id, series_name, unit
| order by endpoint asc, series_id asc

// Is data arriving completely? (rows per 5 minutes, empty columns,
// frequency events that were wrongly routed into energy_raw)
energy_raw
| where ingestion_time() > ago(30m)
| summarize Rows = count(),
            ts_empty = countif(isnull(ts)),
            value_empty = countif(isnull(value)),
            frequency_misrouted = countif(endpoint == "frequency")
    by Ingested = bin(ingestion_time(), 5m)
| order by Ingested desc

// How many values were corrected later? (backfill effect, last 3 days)
energy_raw
| where endpoint == "public_power" and ts > ago(3d)
| summarize Versions = dcount(generated_at), Min = min(value), Max = max(value)
    by series_id, ts
| where Versions > 1 and Max - Min > 0
| summarize Corrected_Values = count(), Max_Correction_MW = max(Max - Min) by series_id
| order by Corrected_Values desc


// ============================================================
// EXAMPLE QUERIES
// ============================================================

// Power mix of the last 24 h (generation per source, MW)
energy_latest
| where endpoint == "public_power" and ts > ago(24h) and unit == "MW"
| where series_id !has "load"
| project ts, series_name, value
| render areachart with (kind=stacked)

// Current traffic light and renewable share incl. forecast
energy_latest
| where endpoint == "signal" and ts between (ago(6h) .. now(24h))
| project ts, series_id, value, is_forecast
| order by ts asc
