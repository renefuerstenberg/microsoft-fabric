// ============================================================
// Helper functions for the Fabric data agent "Power Mix Agent"
// Database eh_1. Run each .create-or-alter block separately.
//
// Why: the data agent translates questions into KQL (NL2KQL) and can
// use user-defined functions. These functions hide the long-format
// storage, unit conversions and naming details, so the agent writes
// short, correct queries.
//
// Conventions for all functions:
//   ts          timestamp in UTC (use it for filtering – fast)
//   Time_local  same timestamp in German local time (Europe/Berlin)
//   Units are part of the column name (GW, MW, Pct, ct_kWh, Hz, mHz)
//
// Note: never use "latest" as a variable name – it is reserved in KQL.
// ============================================================


// ------------------------------------------------------------
// A1) PowerMix(): generation per energy source group, 15-min values
// ------------------------------------------------------------
.create-or-alter function with (folder = "Agent", docstring = "Public net power generation in Germany per energy source group (15-minute values, GW). IsRenewable marks renewable sources.")
PowerMix() {
    let Sources = datatable(series_id: string, Source: string, IsRenewable: bool)
    [
        "fossil_brown_coal_lignite", "Lignite",        false,
        "fossil_hard_coal",          "Hard coal",      false,
        "fossil_gas",                "Natural gas",    false,
        "fossil_oil",                "Other fossil",   false,
        "fossil_coal_derived_gas",   "Other fossil",   false,
        "waste",                     "Other",          false,
        "others",                    "Other",          false,
        "geothermal",                "Other",          false,
        "biomass",                   "Biomass",        true,
        "hydro_run_of_river",        "Hydro",          true,
        "hydro_water_reservoir",     "Hydro",          true,
        "hydro_pumped_storage",      "Pumped storage", false,
        "wind_offshore",             "Wind offshore",  true,
        "wind_onshore",              "Wind onshore",   true,
        "solar",                     "Solar",          true
    ];
    energy_latest
    | where endpoint == "public_power"
    | join kind=inner Sources on series_id
    | summarize GW = round(sum(value) / 1000, 3) by ts, Source, IsRenewable
    | extend Time_local = datetime_utc_to_local(ts, "Europe/Berlin")
}


// ------------------------------------------------------------
// A2) LoadAndShare(): load, residual load and renewable share
// ------------------------------------------------------------
.create-or-alter function with (folder = "Agent", docstring = "Electricity load, residual load (GW) and renewable share of load (%) in Germany, 15-minute values from the generation data.")
LoadAndShare() {
    energy_latest
    | where endpoint == "public_power"
        and series_id in ("load", "residual_load", "renewable_share_of_load")
    | summarize Load_GW = round(maxif(value, series_id == "load") / 1000, 2),
                ResidualLoad_GW = round(maxif(value, series_id == "residual_load") / 1000, 2),
                RenewableShare_Pct = round(maxif(value, series_id == "renewable_share_of_load"), 1)
        by ts
    | extend Time_local = datetime_utc_to_local(ts, "Europe/Berlin")
}


// ------------------------------------------------------------
// A3) TrafficLight(): Energy-Charts signal incl. forecast
// ------------------------------------------------------------
.create-or-alter function with (folder = "Agent", docstring = "Energy-Charts traffic light (2 green, 1 yellow, 0 red, -1 grid congestion) and renewable share incl. forecast, 15-minute values. IsFuture = forecast.")
TrafficLight() {
    energy_latest
    | where endpoint == "signal"
    | summarize TrafficLight = toint(maxif(value, series_id == "signal")),
                RenewableShare_Pct = round(maxif(value, series_id == "share"), 1)
        by ts
    | extend TrafficLightText = case(TrafficLight == 2, "green",
                                     TrafficLight == 1, "yellow",
                                     TrafficLight == 0, "red",
                                     TrafficLight == -1, "grid congestion",
                                     "unknown"),
             IsFuture = ts > now(),
             Time_local = datetime_utc_to_local(ts, "Europe/Berlin")
}


// ------------------------------------------------------------
// A4) DayAheadPrice(): day-ahead exchange price DE-LU
// ------------------------------------------------------------
.create-or-alter function with (folder = "Agent", docstring = "Day-ahead exchange electricity price for the bidding zone DE-LU per quarter-hour, in EUR/MWh and ct/kWh. Includes tomorrow once the auction is published (~13:00).")
DayAheadPrice() {
    energy_latest
    | where endpoint == "price"
    | project ts,
              Time_local = datetime_utc_to_local(ts, "Europe/Berlin"),
              Price_EUR_MWh = round(value, 2),
              Price_ct_kWh = round(value / 10, 3)
}


// ------------------------------------------------------------
// A5) CrossBorderFlows(): physical flows per neighbouring country
// ------------------------------------------------------------
.create-or-alter function with (folder = "Agent", docstring = "Physical cross-border power flows between Germany and each neighbouring country, 15-minute values in MW. Positive = import into Germany. CountriesReported = how many of 11 countries had reported for that timestamp.")
CrossBorderFlows() {
    let Countries = datatable(series_id: string, Country: string)
    [
        "austria", "Austria", "belgium", "Belgium", "czech_republic", "Czech Republic",
        "denmark", "Denmark", "france", "France", "luxembourg", "Luxembourg",
        "netherlands", "Netherlands", "norway", "Norway", "poland", "Poland",
        "sweden", "Sweden", "switzerland", "Switzerland"
    ];
    let reported = energy_latest
        | where endpoint == "cbpf" and series_id != "sum"
        | summarize CountriesReported = countif(value != 0) by ts;
    energy_latest
    | where endpoint == "cbpf"
    | join kind=inner Countries on series_id
    | join kind=inner reported on ts
    | project ts,
              Time_local = datetime_utc_to_local(ts, "Europe/Berlin"),
              Country,
              Flow_MW = round(value * 1000, 0),
              CountriesReported
}


// ------------------------------------------------------------
// A6) NetImport(): net exchange with all neighbours
// ------------------------------------------------------------
.create-or-alter function with (folder = "Agent", docstring = "Net physical power exchange of Germany with all neighbouring countries, 15-minute values in GW. Positive = net import, negative = net export. CountriesReported = how many of 11 countries had reported.")
NetImport() {
    let reported = energy_latest
        | where endpoint == "cbpf" and series_id != "sum"
        | summarize CountriesReported = countif(value != 0) by ts;
    energy_latest
    | where endpoint == "cbpf" and series_id == "sum"
    | join kind=inner reported on ts
    | project ts,
              Time_local = datetime_utc_to_local(ts, "Europe/Berlin"),
              NetImport_GW = round(value, 3),
              CountriesReported
}


// ------------------------------------------------------------
// A7) GridFrequencyPerMinute(): frequency band per minute
//     (GridFrequency() with second values already exists)
// ------------------------------------------------------------
.create-or-alter function with (folder = "Agent", docstring = "Grid frequency of the Continental European grid per minute: minimum, average and maximum in Hz and the largest deviation from 50 Hz in mHz. Use for periods longer than a few hours.")
GridFrequencyPerMinute() {
    frequency_1min
    | project ts,
              Time_local = datetime_utc_to_local(ts, "Europe/Berlin"),
              Min_Hz = round(hz_min, 4),
              Avg_Hz = round(hz_avg, 4),
              Max_Hz = round(hz_max, 4),
              MaxDeviation_mHz = round(max_of(abs(hz_max - 50), abs(hz_min - 50)) * 1000, 1),
              Samples = samples
}


// ------------------------------------------------------------
// A8) PriceVsRenewableShare(): fixed analysis for the data agent
//     Price per renewable-share band + one "Total" row with the
//     overall average, number of quarter-hours and correlation.
//     Each figure appears exactly once (no repeated totals per row –
//     the language model would otherwise sum them up).
//     Encapsulates the statistics so the agent always computes
//     them the same way.
// ------------------------------------------------------------
.create-or-alter function with (folder = "Agent", docstring = "Average day-ahead price (ct/kWh and EUR/MWh) per renewable-share band, plus one row 'Total (all quarter-hours)' with the overall weighted average price, the total number of quarter-hours and the overall correlation between renewable share and price, for the last <lookback> (default 30 days). Use this for any question about how the electricity price depends on the renewable share.")
PriceVsRenewableShare(lookback: timespan = 30d) {
    let base = LoadAndShare()
        | where ts > ago(lookback)
        | join kind=inner (DayAheadPrice() | where ts > ago(lookback) | project ts, Price_ct_kWh) on ts;
    let bands = base
        | extend RenewableBand = case(RenewableShare_Pct >= 100, "5: 100 % and more",
                                      RenewableShare_Pct >= 80,  "4: 80–100 %",
                                      RenewableShare_Pct >= 60,  "3: 60–80 %",
                                      RenewableShare_Pct >= 40,  "2: 40–60 %",
                                                                 "1: below 40 %")
        | summarize Avg_ct_kWh = round(avg(Price_ct_kWh), 2),
                    Avg_EUR_MWh = round(avg(Price_ct_kWh) * 10, 1),
                    QuarterHours = count(),
                    From_local = min(Time_local), To_local = max(Time_local)
            by RenewableBand;
    let total = base
        | summarize n = count(),
                    sx = sum(RenewableShare_Pct), sy = sum(Price_ct_kWh),
                    sxy = sum(RenewableShare_Pct * Price_ct_kWh),
                    sxx = sum(RenewableShare_Pct * RenewableShare_Pct),
                    syy = sum(Price_ct_kWh * Price_ct_kWh),
                    From_local = min(Time_local), To_local = max(Time_local)
        | project RenewableBand = "6: Total (all quarter-hours)",
                  Avg_ct_kWh = round(sy / n, 2),
                  Avg_EUR_MWh = round(sy / n * 10, 1),
                  QuarterHours = n,
                  Correlation = round((n * sxy - sx * sy) / sqrt((n * sxx - sx * sx) * (n * syy - sy * sy)), 2),
                  From_local, To_local;
    union bands, total
    | project RenewableBand, Avg_ct_kWh, Avg_EUR_MWh, QuarterHours, Correlation, From_local, To_local
    | order by RenewableBand asc
}


// ============================================================
// CHECKS – every query should return rows
// ============================================================

.show functions
| where Folder == "Agent" or Name == "GridFrequency"
| project Name, Folder, DocString

PowerMix() | where ts > ago(3h) | top 5 by ts desc

LoadAndShare() | where ts > ago(3h) | top 3 by ts desc

TrafficLight() | where ts > ago(1h) | top 3 by ts desc

DayAheadPrice() | where ts > ago(2h) | top 3 by ts desc

CrossBorderFlows() | where ts > ago(6h) | top 11 by ts desc

NetImport() | where ts > ago(6h) | top 3 by ts desc

GridFrequencyPerMinute() | where ts > ago(15m) | top 3 by ts desc

PriceVsRenewableShare()
